{
  "expo": {
    "name": "Study Habits",
    "slug": "Study-Habits",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "studyhabits",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studyhabits"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#274A39"
      },
      "icon": "./assets/icon-android.png",
      "package": "com.studyhabits",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ],
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#274A39",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "android": {
            "imageWidth": 172
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ef40384-03f5-4e1f-9c75-3506cd2a69d9"
      }
    }
  }
}
